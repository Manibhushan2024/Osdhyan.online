# ═══ OSDHYAN server settings ═══════════════════════════════════════════
# Copy to deploy/.env on the server and fill in. NEVER commit deploy/.env.
# scripts/first-deploy.sh fills APP_KEY and POSTGRES_PASSWORD for you.

# ─── Address ───────────────────────────────────────────────────────────
# Public address(es) Caddy serves. With a domain, HTTPS is automatic.
# First test on a bare IP: SITE_ADDRESS=:80 and APP_URL=http://<server-ip>
SITE_ADDRESS=osdhyan.online, www.osdhyan.online
APP_URL=https://osdhyan.online
FRONTEND_URL=https://osdhyan.online
ALLOWED_ORIGINS=https://osdhyan.online,https://www.osdhyan.online
SANCTUM_STATEFUL_DOMAINS=osdhyan.online,www.osdhyan.online
ACME_EMAIL=
HTTP_PORT=80
HTTPS_PORT=443

# ─── App ───────────────────────────────────────────────────────────────
APP_NAME=OSDHYAN
APP_ENV=production
APP_DEBUG=false
APP_KEY=
LOG_LEVEL=warning
# php-fpm workers: 1 GB RAM→12, 2 GB→25, 4 GB→50 (backend container share)
FPM_MAX_CHILDREN=40

# Root admin created/updated on boot ONLY while ADMIN_PASSWORD is set.
# Set it for the first boot, then blank it and restart.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Super Admin
ADMIN_PHONE=9999999999

# ─── Database (internal; never exposed) ───────────────────────────────
POSTGRES_PASSWORD=
BACKUP_KEEP_DAYS=30
BACKUP_HOUR=2

# ─── E-mail (needed: production never shows OTP codes on screen) ──────
# Gmail/Workspace: smtp.gmail.com 587 + App Password
# Brevo: smtp-relay.brevo.com 587 + SMTP key (300/day free)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=OSDHYAN

# ─── SMS gateway (optional; Firebase phone OTP needs none) ────────────
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_GATEWAY_URL=
SMS_GATEWAY_USER=
SMS_GATEWAY_PASSWORD=

# ─── Firebase (Phase 2) ───────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=

# ─── Google sign-in (optional) ────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ─── Payments (fake payments are refused in production anyway) ─────
PAYMENTS_FAKE=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Live classes / AI / errors (optional) ───────────────────────────
JITSI_DOMAIN=meet.jit.si
AI_PROVIDER=
AI_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
SENTRY_LARAVEL_DSN=
