user www-data;
worker_processes auto;
worker_rlimit_nofile 65535;
error_log /dev/stderr warn;
pid /run/nginx.pid;

events {
    worker_connections 8192;
    multi_accept on;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    tcp_nopush    on;
    tcp_nodelay   on;
    keepalive_timeout 65;
    keepalive_requests 1000;
    server_tokens off;
    client_max_body_size 520M;
    access_log off;

    # JSON payloads (whole tests with Hindi text) compress ~8x.
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types application/json text/plain text/css application/javascript text/csv;

    server {
        listen ${PORT} default_server;
        server_name _;
        root /var/www/osdhyan/public;
        index index.php;

        location / {
            try_files $uri $uri/ /index.php?$query_string;
        }

        location ~ \.php$ {
            fastcgi_pass 127.0.0.1:9000;
            fastcgi_index index.php;
            fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
            fastcgi_param DOCUMENT_ROOT $realpath_root;
            include fastcgi_params;
            fastcgi_read_timeout 70;
            fastcgi_buffers 16 32k;
            fastcgi_buffer_size 64k;
        }

        location /storage/ {
            alias /var/www/osdhyan/storage/app/public/;
            expires 7d;
            try_files $uri =404;
        }

        # Android app downloads: correct type so phones offer to install,
        # and no week-long caching (a new APK replaces osdhyan.apk).
        location /storage/downloads/ {
            alias /var/www/osdhyan/storage/app/public/downloads/;
            types { application/vnd.android.package-archive apk; }
            default_type application/octet-stream;
            add_header Cache-Control "no-cache";
            try_files $uri =404;
        }

        location ~ /\.(?!well-known) {
            deny all;
        }
    }
}
